      "operation": "Remove user parts",
      "actions": [
        {
          "node_id": 57,
          "text": "Lift out the 0.5 L removable water tank from its seat at the rear of the machine.",
          "tools": "Hands",
          "image": null
        },
        {
          "node_id": 58,
          "text": "Pull out the used-capsule drawer from the front-bottom slot.",
          "tools": "Hands",
          "image": null
        },
        {
          "node_id": 59,
          "text": "Release the 2 Phillips PH1 screws of the capsule lever / brewing-group assembly and lift it out.",
          "tools": "Phillips PH1 screwdriver",
          "image": null
        }
      ],
