  "steps": [
    {
      "index": 1,
      "operation": "Open outer shell",
      "actions": [
        {
          "node_id": 3,
          "text": "Place the machine upside-down on a soft cloth so the bottom plate is accessible; remove any residual water from the tank seat to avoid leaks.",
          "tools": "Soft cloth",
          "image": null
        },
        {
          "node_id": 4,
          "text": "Unscrew the 4 Torx T10 screws located at the corners of the bottom plate.",
          "tools": "Torx T10 screwdriver",
          "image": null
        },
        {
          "node_id": 5,
          "text": "Unscrew the 2 Phillips PH1 screws behind the rear panel, near the power-cord grommet.",
          "tools": "Phillips PH1 screwdriver",
          "image": null
        },
        {
          "node_id": 6,
          "text": "Release the 4 internal plastic clips along the vertical edges by gently prying with a flat plastic tool.",
          "tools": "Plastic pry tool",
          "image": null
        },
        {
          "node_id": 7,
          "text": "Lift the upper shell vertically, keeping it parallel to the base, to separate it from the internal chassis.",
          "tools": "Hands",
          "image": null
        }
      ],
      "outputs": [
        {
          "node_id": 8,
          "name": "Outer shell",
          "weight": 260.0,
          "weight_unit": "g",
          "material": "ABS (50% PCR on Responsible variant)",
          "color": null,
          "image": null,
