    {
      "index": 3,
      "operation": "Remove control panel",
      "actions": [
        {
          "node_id": 11,
          "text": "Unplug the JST-XH 4-pin connector that links the front button board to the main PCB; press the latch before pulling.",
          "tools": "JST connector tool",
          "image": null
        },
        {
          "node_id": 12,
          "text": "Unplug the JST-PH 2-pin connector of the aluminium-capsule sensor, located just behind the capsule lever assembly.",
          "tools": "JST connector tool",
          "image": null
        },
        {
          "node_id": 13,
          "text": "Unscrew the 2 Phillips PH0 screws that hold the button panel to the front of the chassis.",
          "tools": "Phillips PH0 screwdriver",
          "image": null
        },
        {
          "node_id": 14,
          "text": "Slide the button panel forward and lift it out together with the integrated LED indicators and the capsule sensor.",
          "tools": "Hands",
          "image": null
        }
      ],
      "outputs": [
        {
          "node_id": 15,
          "name": "Button panel",
          "weight": 35.0,
