    {
      "index": 6,
      "operation": "Extract thermoblock",
      "actions": [
        {
          "node_id": 39,
          "text": "Verify the machine has been unplugged for at least 30 minutes so the thermoblock has fully cooled before touching the metal body.",
          "tools": "Heat-resistant gloves (precaution)",
          "image": null
        },
        {
          "node_id": 40,
          "text": "Disconnect the two faston terminals of the heating element from the harness, and the 2-pin JST of the safety thermostat.",
          "tools": "Hands",
          "image": null
        },
        {
          "node_id": 41,
          "text": "Unscrew the brass nut at the thermoblock outlet (towards the brew chamber) using a 10 mm wrench; keep a cloth nearby for residual drips.",
          "tools": "10 mm wrench",
          "image": null
        },
        {
          "node_id": 42,
          "text": "Unscrew the 2 Phillips PH1 screws of the thermoblock bracket on the chassis side wall.",
          "tools": "Phillips PH1 screwdriver",
          "image": null
        },
        {
          "node_id": 43,
          "text": "Lift the thermoblock assembly vertically out of its seat.",
          "tools": "Hands",
          "image": null
        }
      ],
