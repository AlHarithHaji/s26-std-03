    {
      "index": 7,
      "operation": "Disassemble thermoblock",
      "actions": [
        {
          "node_id": 47,
          "text": "Clamp the aluminium body in a bench vice with soft jaws to avoid marking the surface; keep the heating-element side accessible.",
          "tools": "Bench vice with soft jaws",
          "image": null
        },
        {
          "node_id": 48,
          "text": "Unscrew the safety thermostat from its threaded seat on the body; it comes out as a single threaded brass capsule.",
          "tools": "Hex key (typically 4 mm)",
          "image": null
        },
        {
          "node_id": 49,
          "text": "Push out the heating element from its dedicated tunnel inside the aluminium body, gently tapping with a soft mallet if needed.",
          "tools": "Soft mallet",
          "image": null
        },
        {
          "node_id": 50,
          "text": "Separate the stainless-steel tube (water path) from the aluminium body; depending on the design, this may require a press or destructive cut.",
