    {
      "index": 5,
      "operation": "Extract PCB & wiring",
      "actions": [
        {
          "node_id": 29,
          "text": "Unplug all remaining JST connectors from the main PCB: thermostat lead, thermoblock heater lead, pump triac lead.",
          "tools": "JST connector tool",
          "image": null
        },
        {
          "node_id": 30,
          "text": "Disconnect the mains input wires from the PCB screw terminals (LIVE / NEUTRAL / EARTH).",
          "tools": "Phillips PH0 screwdriver",
          "image": null
        },
        {
          "node_id": 31,
          "text": "Cut any cable ties that fix the wiring harness to the chassis ribs.",
          "tools": "Side cutters",
          "image": null
        },
        {
          "node_id": 32,
          "text": "Unscrew the 4 Phillips PH0 screws securing the PCB to its plastic tray and lift the board out.",
          "tools": "Phillips PH0 screwdriver",
          "image": null
        },
        {
          "node_id": 33,
          "text": "Pull the wiring harness and the power cord through the chassis cut-out as a single bundle.",
          "tools": "Hands",
          "image": null
        }
      ],
