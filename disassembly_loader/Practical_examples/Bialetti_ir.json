    {
      "index": 4,
      "operation": "Extract hydraulic circuit",
      "actions": [
        {
          "node_id": 19,
          "text": "Place a container under the chassis to catch ~30 mL of residual water that will drip from the tubing during removal.",
          "tools": "Container",
          "image": null
        },
        {
          "node_id": 20,
          "text": "Release the spring clamp on the silicone tube from the tank valve to the pump inlet; slide the tube off the barb.",
          "tools": "Hose clamp pliers",
          "image": null
        },
        {
          "node_id": 21,
          "text": "Release the spring clamps on the silicone tubes from the pump outlet to the flow meter, and from the flow meter to the thermoblock inlet.",
          "tools": "Hose clamp pliers",
          "image": null
        },
        {
          "node_id": 22,
          "text": "Unplug the 2-pin power connector that supplies the pump from the main PCB.",
          "tools": "Hands",
          "image": null
        },
        {
          "node_id": 23,
          "text": "Unscrew the 2 Phillips PH1 screws holding the pump bracket to the chassis, then lift the pump together with the flow meter and the tubing as a single hydraulic assembly.",
          "tools": "Phillips PH1 screwdriver",
          "image": null
        }
      ],
